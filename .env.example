# ---- Application ----------------------------------------------------------
APP_ENV=development              # development | staging | production
APP_BASE_URL=https://your-domain.com   # public HTTPS URL (legal pages, OAuth callback, webhook)
LOG_LEVEL=INFO

# ---- Telegram -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=              # from @BotFather
BOT_MODE=polling                 # polling | webhook (webhook requires `python -m app.main all`)
TELEGRAM_WEBHOOK_SECRET=         # random string, required for webhook mode

# ---- AI -------------------------------------------------------------------
AI_PROVIDER=openai               # openai | gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Infrastructure -------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://copilot:copilot@postgres:5432/copilot
REDIS_URL=redis://redis:6379/0

# ---- Job search -----------------------------------------------------------
JOB_SEARCH_PROVIDER=
JOB_SEARCH_API_KEY=

# ---- Google OAuth (Gmail) -------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.com/oauth/google/callback

# ---- File storage ---------------------------------------------------------
STORAGE_BACKEND=s3               # local | s3
LOCAL_STORAGE_PATH=./var/storage
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ai-job-copilot
S3_REGION=us-east-1

# ---- Security -------------------------------------------------------------
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
ADMIN_TELEGRAM_IDS=              # comma-separated Telegram user ids
PRIVACY_POLICY_VERSION=2026-11-01
SUPPORT_CONTACT=@your_support_account

# ---- Limits ---------------------------------------------------------------
FREE_APPLICATION_LIMIT=5
DAILY_APPLICATION_LIMIT=20
MAX_UPLOAD_MB=10
RATE_LIMIT_EVENTS=30
RATE_LIMIT_WINDOW_SECONDS=10
OCR_LANGUAGES=eng+deu+ukr+rus

# ---- Development only -----------------------------------------------------
# MOCK_MODE replaces the AI provider with a deterministic offline parser.
# It is rejected at startup when APP_ENV=production.
MOCK_MODE=false
